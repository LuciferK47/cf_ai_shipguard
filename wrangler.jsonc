{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cf-ai-shipguard",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],

  // Workers AI has no local simulator, so `wrangler dev` proxies this binding
  // to Cloudflare. That is why local development needs `wrangler login`.
  "ai": { "binding": "AI", "remote": true },

  // Caches AI analysis per (repository, commit SHA, prompt version, model).
  // No `id`: `wrangler deploy` provisions the namespace automatically.
  "kv_namespaces": [{ "binding": "ANALYSIS_CACHE" }],

  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/agents/*", "/api/*"]
  },

  "durable_objects": {
    "bindings": [{ "name": "ShipGuardAgent", "class_name": "ShipGuardAgent" }]
  },

  // Declarative Durable Object class lifecycle: the current recommendation for
  // new Workers, in place of the legacy `migrations` array. A Worker cannot
  // use both. https://developers.cloudflare.com/durable-objects/reference/durable-objects-migrations/
  "exports": {
    "ShipGuardAgent": { "type": "durable-object", "storage": "sqlite" }
  },

  "workflows": [
    {
      "name": "shipguard-audit",
      "binding": "AUDIT_WORKFLOW",
      "class_name": "AuditWorkflow"
    }
  ],

  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  }
}
