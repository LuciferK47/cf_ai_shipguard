{
  "name": "healthy-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [{ "name": "COUNTER", "class_name": "Counter" }]
  },
  "exports": { "Counter": { "type": "durable-object", "storage": "sqlite" } },
  "workflows": [
    { "name": "healthy-flow", "binding": "FLOW", "class_name": "HealthyFlow" }
  ],
  "vars": { "API_TOKEN": "", "LOG_LEVEL": "info" }
}
