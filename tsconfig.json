{
  "extends": "agents/tsconfig",
  "compilerOptions": {
    // Runtime types come from `wrangler types` (env.d.ts), not the
    // @cloudflare/workers-types package.
    "types": ["node", "vite/client", "@cloudflare/vitest-plugin/types"],
    // vitest.config.ts is loaded by Node directly, which needs explicit extensions.
    "allowImportingTsExtensions": true
  },
  // The example is a separate project with its own bindings and types.
  "exclude": ["examples", "dist", "node_modules"]
}
